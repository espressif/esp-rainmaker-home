<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      No external-storage permissions in the CN build.

      READ_/WRITE_EXTERNAL_STORAGE reach the merged manifest from
      expo-image-picker / expo-file-system / expo-image (and READ from the
      main manifest). The only code that would request them is the chat
      image attachment (src/features/agent/hooks/useChatMediaAttachment.ts),
      which the CN build does not ship (ENABLE_AI_AGENT=false) — and on
      API 33+ even that uses the system photo picker, which needs no
      permission. A declared permission with no matching feature is a
      finding in app-store privacy review on its own, so they are removed
      here rather than justified in each store's permission declaration
      form.

      Keep this in sync with ENABLE_AI_AGENT for the CN region: if the chat
      agent is ever enabled in a CN build, gallery picking on API 32 and
      below needs READ_EXTERNAL_STORAGE back.
    -->
    <!--
      No POST_NOTIFICATIONS in the CN build either. The CN flavor ships
      without Firebase/FCM (notification feature flag off, PushBootstrap is
      a no-op, ESPNotificationModule is a stub), and the only code that
      posts a notification is FCMService in the `global` source set — so the
      permission is never requested here. Restore it if CN ever gains a push
      transport (HMS / Xiaomi Push / self-hosted).
    -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:node="remove" />

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />

    <!--
      No SYSTEM_ALERT_WINDOW in CN release builds: the app draws nothing
      outside its own window. Only React Native's dev menu needs it, and
      src/debug/AndroidManifest.xml declares it for debug builds.
    -->
    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW"
        tools:node="remove" />

    <!--
      CN-flavor-only components. WeChat login ships only in the CN build (the
      WeChat SDK and its native modules live in the `cn` source set).
    -->

    <!-- WeChat must be able to see its host app for IPC. -->
    <queries>
        <package android:name="com.tencent.mm" />
    </queries>

    <application>

        <!-- OTA URL override: CN APK fetches CN-built bundles. See deployment/ota/README.md. -->
        <meta-data
            android:name="expo.modules.updates.EXPO_UPDATE_URL"
            android:value="https://app.rainmaker.espressif.com/ota/prod/cn/android/manifest.json"
            tools:replace="android:value" />

        <!--
          Belt-and-braces for the CN Firebase exclusion. The Crashlytics gradle
          plugin is already gated to non-CN builds, but autolinking still links
          the RNFirebase module into every variant, so pin collection off here
          too: CN must never attempt to report to Google.
        -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />

        <!--
          WeChat OAuth callback activity. The WeChat SDK delivers the auth result
          to the component named <applicationId>.wxapi.WXEntryActivity. The real
          class lives in the stable com.app.wechat package; the alias below
          exposes it under the WeChat-required, applicationId-derived name so this
          keeps working regardless of ANDROID_APP_APPLICATION_ID.
        -->
        <activity
            android:name="com.app.wechat.WXEntryActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="" />

        <activity-alias
            android:name="${applicationId}.wxapi.WXEntryActivity"
            android:targetActivity="com.app.wechat.WXEntryActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${WECHAT_APP_ID}" />
            </intent-filter>
        </activity-alias>

        <!-- Keeps WeChat registration alive via ACTION_REFRESH_WXAPP. -->
        <receiver
            android:name="com.app.wechat.AppRegister"
            android:exported="true"
            android:permission="com.tencent.mm.plugin.permission.SEND">
            <intent-filter>
                <action android:name="com.tencent.mm.plugin.openapi.Intent.ACTION_REFRESH_WXAPP" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
