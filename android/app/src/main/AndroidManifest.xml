        <meta-data
            android:name="expo.modules.updates.CODE_SIGNING_METADATA"
            android:value="{&quot;alg&quot;:&quot;rsa-v1_5-sha256&quot;,&quot;keyid&quot;:&quot;main&quot;}" />

        <activity
            android:name="com.app.MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App.SplashScreen"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <!-- Agents deep links, host/path-scoped -->
                <data
                    android:host="${AGENTS_DEEP_LINK_HOST}"
                    android:pathPrefix="${AGENTS_DEEP_LINK_PATH_PREFIX}"
                    android:scheme="${AGENTS_DEEP_LINK_SCHEME}" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="${applicationId}" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <!-- HTTPS deep links from gradle.properties via manifestPlaceholders -->
                <data android:scheme="https" android:host="${AGENTS_DEEP_LINK_HOST}" 
                android:pathPrefix="${AGENTS_DEEP_LINK_PATH_PREFIX}" />
            </intent-filter>
        </activity>

        <!-- Dedicated OAuth Redirect Activity -->
        <activity
            android:name=".oauth.OAuthRedirectActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <!-- OAuth redirect URL from gradle.properties via manifestPlaceholders -->
                <data
                    android:host="${THIRD_PARTY_AUTH_REDIRECT_HOST}"
                    android:scheme="${THIRD_PARTY_AUTH_REDIRECT_SCHEME}" />
            </intent-filter>
        </activity>

        <!-- In-app ChipTool commissioning activity (no Google Play services dependency).
             Selected at build time via MATTER_COMMISSIONING_METHOD; launched from
             ESPMatterModule.startEcosystemCommissioning. -->
        <activity
            android:name=".matter.ChipToolCommissioningActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />

        <!-- Headless JS Task Service for Matter Commissioning -->
        <service
            android:name=".matter.MatterHeadlessTaskService"
            android:exported="false" />

        <!-- Google-dependent components (FCM service, Google Play services Matter
             commissioning activity + service) are declared in the `global` flavor
             manifest (src/global/AndroidManifest.xml) so they are excluded from
             the CN build, which ships without Firebase / Google Play services. -->
    </application>
</manifest>