default_platform(:android)

platform :android do

  lane :apk do |options|
    flavor = (options[:flavor] || "global").to_s

    Dir.chdir("..") do
      sh("./gradlew assemble#{flavor.capitalize}Release --parallel --build-cache")

      artifacts_dir = "../artifacts/android"
      apk_glob = "app/build/outputs/apk/#{flavor}/release/*.apk"

      sh("mkdir -p #{artifacts_dir}")

      apks = Dir.glob(apk_glob)
      if apks.empty?
        sh("echo 'No APKs found at #{apk_glob}'")
        sh("ls -la app/build/outputs/apk || true")
        sh("ls -la app/build/outputs/apk/#{flavor} || true")
        UI.user_error!("APK not produced")
      end

      sh("cp #{apk_glob} #{artifacts_dir}/app-#{flavor}-release.apk")
    end
  end

end
