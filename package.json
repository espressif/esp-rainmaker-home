{
  "name": "NOVA",
  "main": "expo-router/entry",
  "version": "6.0.0",
  "scripts": {
    "start": "expo start",
    "start:dev": "APP_ENV=development expo start -c",
    "start:staging": "APP_ENV=staging expo start -c",
    "start:prod": "APP_ENV=production expo start -c",
    "prebuild": "npm run prebuild:android && npm run prebuild:ios",
    "prebuild:android": "node scripts/sync-env-to-android.js",
    "prebuild:android:global": "{ test -s .env || { cp .env.global .env 2>/dev/null || cp .env.global.example .env; }; } && npm run prebuild:android",
    "prebuild:android:cn": "{ test -s .env || { cp .env.cn .env 2>/dev/null || cp .env.cn.example .env; }; } && npm run prebuild:android",
    "prebuild:ios": "node scripts/sync-env-to-ios.js",
    "android": "npm run android:global",
    "android:global": "{ cp .env.global .env 2>/dev/null || cp .env.global.example .env; } && npm run prebuild:android && expo run:android --variant globalDebug",
    "android:cn": "{ cp .env.cn .env 2>/dev/null || cp .env.cn.example .env; } && npm run prebuild:android && expo run:android --variant cnDebug --app-id $(grep '^ANDROID_APP_APPLICATION_ID=' .env | cut -d '=' -f2 | tr -d '[:space:]')",
    "build:android": "npm run build:android:global",
    "build:android:global": "{ cp .env.global .env 2>/dev/null || cp .env.global.example .env; } && npm run prebuild:android && cd android && ./gradlew assembleGlobalRelease",
    "build:android:cn": "{ cp .env.cn .env 2>/dev/null || cp .env.cn.example .env; } && npm run prebuild:android && cd android && ./gradlew assembleCnRelease",
    "ios": "cp .env.global.example .env && npm run prebuild:ios && expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "lint:arch": "depcruise src config app --config .dependency-cruiser.cjs --validate --output-type err",
    "typecheck": "tsc --noEmit",
    "check:arch": "npm run lint:arch",
    "spell": "cspell lint --no-progress",
    "check": "npm run typecheck && npm run spell && npm run lint:arch && npm run lint",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-kinesis-video": "^3.700.0",
    "@aws-sdk/client-kinesis-video-signaling": "^3.700.0",
    "@espressif/rainmaker-base-cdf": "2.2.0",
    "@espressif/rainmaker-base-sdk": "3.3.0",
    "@espressif/rainmaker-matter-sdk": "3.1.0",
    "@espressif/rainmaker-neo-base-sdk": "1.0.0",
    "@expo/vector-icons": "^14.0.2",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-community/checkbox": "^0.5.17",
    "@react-native-community/slider": "5.1.2",
    "@react-native-picker/picker": "^2.6.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@shopify/react-native-skia": "2.4.18",
    "@tamagui/config": "1.126.12",
    "@tamagui/core": "1.126.12",
    "@tamagui/toast": "1.126.12",
    "@types/react": "~19.2.0",
    "axios": "1.10.0",
    "buffer": "^6.0.3",
    "burnt": "^0.13.0",
    "crypto-js": "^4.2.0",
    "expo": "^55.0.0",
    "expo-blur": "~55.0.14",
    "expo-camera": "~55.0.16",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.15",
    "expo-dev-client": "~55.0.30",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.14",
    "expo-localization": "~55.0.16",
    "expo-navigation-bar": "~55.0.12",
    "expo-network": "~55.0.13",
    "expo-react-native-restart": "^0.1.1",
    "expo-router": "~55.0.13",
    "expo-screen-orientation": "~55.0.13",
    "expo-splash-screen": "~55.0.19",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.16",
    "expo-web-browser": "~55.0.14",
    "google-protobuf": "^3.21.2",
    "i18next": "^25.1.2",
    "joi": "^17.13.3",
    "lucide-react-native": "^1.14.0",
    "marked": "^17.0.1",
    "mobx": "^6.13.5",
    "mobx-react-lite": "^4.1.0",
    "mqtt": "^5.15.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^15.5.1",
    "react-native": "0.83.6",
    "react-native-calendars": "^1.1313.0",
    "react-native-color-picker": "^0.6.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-pager-view": "^8.0.1",
    "react-native-paper": "^5.13.2",
    "react-native-quick-base64": "^2.2.2",
    "react-native-reanimated": "4.2.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "^0.21.0",
    "react-native-webrtc": "^124.0.7",
    "react-native-websocket": "^1.0.2",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "tamagui": "1.126.12",
    "victory-native": "^41.20.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "latest",
    "@types/crypto-js": "^4.2.2",
    "@types/google-protobuf": "^3.15.6",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~55.0.22",
    "cspell": "^9.8.0",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~55.0.0",
    "eslint-plugin-jsdoc": "^50.8.0",
    "husky": "^9.1.7",
    "jest": "^29.2.1",
    "jest-expo": "~55.0.16",
    "typescript": "^5.3.3"
  },
  "resolutions": {
    "axios": "1.10.0"
  },
  "private": true
}
