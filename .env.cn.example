# =============================================================================
# CN REGION — self-contained config (committed)
# =============================================================================
# ONE layer, one file. Committed TEMPLATE for the CN region. Copy to a local,
# gitignored `.env.cn` and put real values there; builds prefer the local file
# and fall back to this template:
#   npm run android:cn / build:android:cn   → .env.cn (else this template)
#
# It carries BOTH:
#   • Native/build identity — synced into the Android `cn` flavor (gradle) by
#     scripts/sync-env-to-android.js from the copied `.env`.
#   • JS/runtime region config — parsed directly from this file by app.config.ts
#     into extra.regionConfigs.cn (cloud, RMNG, legal links, feature
#     availability). This (region) block is ALSO consumed by the single iOS
#     binary at runtime when the device Region is China (see .env.global).
#
# The iOS binary does NOT copy this file for its native identity — it uses
# .env.global. Only the (region) keys below reach iOS (via regionConfigs.cn).
#
# Keys tagged (region) MUST stay identical (same key names) in .env.global —
# only the values differ between regions.
# =============================================================================

# ── APP IDENTITY & BRANDING (native; Android CN binary only) ──────────────────
APP_NAME=ESP RainMaker Home
IOS_APP_APPLICATION_ID=com.espressif.nova
# Android application id for this region/flavor.
ANDROID_APP_APPLICATION_ID=com.espressif.nova
IOS_APP_GROUP_ID=group.com.espressif.novahome
APP_SLUG=esp-rainmaker-home
APP_SCHEMA=rainmaker

# ── DEPLOYMENT REGION (native selector) — forced to CN for this binary ────────
APP_REGION=cn

# ── VERSION (native) ──────────────────────────────────────────────────────────
APP_VERSION=5.3.0
ANDROID_VERSION_CODE=47

# ── SCAN CONFIGURATION (native/binary capability) ─────────────────────────────
ENABLE_SCAN_CONFIGURATION=true

# ── THIRD-PARTY AUTH NATIVE REDIRECT (Android manifest + BuildConfig) ─────────
THIRD_PARTY_AUTH_REDIRECT_SCHEME=rainmaker
THIRD_PARTY_AUTH_REDIRECT_HOST=com.espressif.nova

# ── DEEP LINK & URL SCHEMES (native) ──────────────────────────────────────────
AGENTS_DEEP_LINK_SCHEME=rainmaker
AGENTS_DEEP_LINK_HOST=agents.espressif.com
AGENTS_DEEP_LINK_PATH_PREFIX=/try/agents

# ── MATTER (native) ───────────────────────────────────────────────────────────
MATTER_VENDOR_ID=0x131B
MATTER_ECOSYSTEM_NAME=Rainmaker Home
# CN uses in-app ChipTool (no Google Play services). The `cn` flavor also
# hard-codes this in BuildConfig regardless of the value here.
MATTER_COMMISSIONING_METHOD=ChipTool

# ── WECHAT LOGIN (native; Android CN binary) ──────────────────────────────────
# App ID must be a WeChat Open Platform app bound to applicationId
# com.espressif.nova + the signing certificate.
WECHAT_APP_ID=wx9d48fe3e583d36ab
WECHAT_UNIVERSAL_LINK=https://wechat-212038829774-prod.s3.cn-north-1.amazonaws.com.cn/

# ── ACTIVE SDK (region) ───────────────────────────────────────────────────────
# rainmaker-base-sdk | rmng-base-sdk | rainmaker-matter-sdk
ACTIVE_SDK=rainmaker-matter-sdk

# ── RM SDK CLOUD (region; China mainland) ─────────────────────────────────────
BASE_URL=https://api2.rainmaker.espressif.com.cn
API_VERSION=v1
THIRD_PARTY_AUTH_AUTH_URL=https://api2.rainmaker.espressif.com.cn
THIRD_PARTY_AUTH_CLIENT_ID=6m3FgmvJSt4g6pDrHgfpYj
THIRD_PARTY_AUTH_REDIRECT_URL=rainmaker://com.espressif.nova/success
CLAIM_URL=https://claiming.rainmaker.espressif.com.cn

# ── RMNG SDK CLOUD (region; no region-specific RMNG cloud yet — same as .env.global) ─
RMNG_BASE_URL=https://c2vxptrsrk.execute-api.ap-south-1.amazonaws.com
RMNG_API_PATH=/prod
RMNG_USER_API_BASE=
RMNG_USER_API_BASE_URL=https://hahrmpl4kj.execute-api.ap-south-1.amazonaws.com
RMNG_USER_API_PATH=/prod
RMNG_IDENTITY_ID=ap-south-1:97779d56-d730-439c-bec0-688a32ea0f76
RMNG_AWS_REGION=ap-south-1
RMNG_USER_POOL_ID=ap-south-1_bB5ywfmj3
RMNG_CLIENT_ID=5vask3aug0ahtbdc7rnqbdvvi7
RMNG_IOT_ENDPOINT=a8q3zcvoujce1-ats.iot.ap-south-1.amazonaws.com

# ── PUBLIC WEBSITE & LEGAL (region; China pages; {lang} replaced at runtime) ──
WEBSITE_LINK=https://rainmaker.espressif.com
TERMS_OF_USE_LINK=https://rainmaker.espressif.com/{lang}/terms-of-use?region=china
PRIVACY_POLICY_LINK=https://rainmaker.espressif.com/{lang}/privacy-policy?region=china

# ── THIRD-PARTY LOGIN PROVIDERS (region; list order = display order) ──────────
# Google is unavailable in CN; WeChat is CN-only. This list IS the region gate.
ENABLE_THIRD_PARTY_AUTH=true
THIRD_PARTY_AUTH_ENABLED_PROVIDERS=WeChat,SignInWithApple

# ── FEATURE AVAILABILITY (region + binary; disable-only cascade) ──────────────
ENABLE_SCENES=true
ENABLE_SCHEDULES=true
ENABLE_AUTOMATIONS=true
ENABLE_LOCAL_CONTROL=true
# Notifications OFF: the Android CN flavor ships without Firebase/FCM. This is a
# push-transport limitation of the Android CN BINARY, not a CN-region policy —
# so config/features.config.ts treats notifications as available on iOS (APNs)
# regardless of this flag; only Android honors it.
ENABLE_NOTIFICATIONS=false
ENABLE_GROUP_SHARING=true
ENABLE_OTA=true
ENABLE_AI_AGENT=true
# Alexa / Google Assistant do not operate in mainland China.
ENABLE_VOICE_ASSISTANTS=false
ENABLE_CONTROL_GROUPS=true
ENABLE_ON_NETWORK_PROVISIONING=true
ENABLE_CDF_AUTOSYNC=true
# ── ANDROID SIGNING (native; release keystore for this flavor) ────────────────
# Written to the gitignored android/keystore.properties by `npm run prebuild:android`
# and read by build.gradle's release signingConfig at build time. Each flavor's
# .env carries its OWN keystore, so a build signs with that flavor's key. Put REAL
# values only in the local .env.global / .env.cn (gitignored); keep the committed
# .example lines blank. The .jks lives under android/app/sign/ (path relative to
# android/app/).
ANDROID_KEYSTORE_FILE=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
