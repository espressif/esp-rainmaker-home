# =============================================================================
# GLOBAL REGION — self-contained config (committed)
# =============================================================================
# ONE layer, one file. Committed TEMPLATE for the GLOBAL region. Copy to a
# local, gitignored `.env.global` and put real values there; builds prefer the
# local file and fall back to this template. The single iOS binary builds from
# THIS committed file (APP_REGION=auto); the Android global flavor builds from
# the local `.env.global` (APP_REGION=global):
#   npm run android / android:global / build:android:global  → .env.global (else this)
#   npm run ios                                              → this template (auto)
#
# It carries BOTH:
#   • Native/build identity — synced into Android (gradle) / iOS (xcconfig) by
#     scripts/sync-env-to-*.js from the copied `.env`.
#   • JS/runtime region config — parsed directly from this file by app.config.ts
#     into extra.regionConfigs.global (cloud, RainMaker Neo, legal links, feature
#     availability). app.config.ts reads BOTH .env.global and .env.cn so the one
#     iOS binary can resolve its region at runtime (config/region.config.ts).
#
# Keys tagged (region) MUST stay identical (same key names) in .env.cn — only
# the values differ between regions.
# =============================================================================

# ── APP IDENTITY & BRANDING (native) ─────────────────────────────────────────
APP_NAME=ESP RainMaker Home
IOS_APP_APPLICATION_ID=com.espressif.nova
# Android application id for this region/flavor. The cn env sets its own value;
# builds are one-flavor-at-a-time, so a single key suffices.
ANDROID_APP_APPLICATION_ID=com.espressif.novahome
IOS_APP_GROUP_ID=group.com.espressif.novahome
APP_SLUG=esp-rainmaker-home
APP_SCHEMA=rainmaker

# ── DEPLOYMENT REGION (native selector) ──────────────────────────────────────
# auto: the single iOS binary (which builds from THIS committed template)
# resolves global vs CN at runtime from the device Region. The Android GLOBAL
# flavor instead builds from the local .env.global, which pins APP_REGION=global
# (its APK omits the CN-only WeChat native module, so it must not runtime-flip to
# CN). Keep this committed template at `auto` for the iOS binary.
APP_REGION=auto

# ── SCAN CONFIGURATION (native/binary capability) ─────────────────────────────
ENABLE_SCAN_CONFIGURATION=true

# ── THIRD-PARTY AUTH NATIVE REDIRECT (Android manifest + BuildConfig) ─────────
# iOS matches the OAuth callback by scheme (rainmaker://) and does not use the
# host; the region OAuth client/endpoints are the (region) keys below.
THIRD_PARTY_AUTH_REDIRECT_SCHEME=rainmaker
THIRD_PARTY_AUTH_REDIRECT_HOST=com.espressif.novahome

# ── DEEP LINK & URL SCHEMES (native) ──────────────────────────────────────────
AGENTS_DEEP_LINK_SCHEME=rainmaker
AGENTS_DEEP_LINK_HOST=agents.espressif.com
AGENTS_DEEP_LINK_PATH_PREFIX=/try/agents

# ── MATTER (native) ───────────────────────────────────────────────────────────
MATTER_VENDOR_ID=0x131B
MATTER_ECOSYSTEM_NAME=Rainmaker Home
# Android global commissions via Google Play services Home APIs.
# (Only affects Android; iOS commissions via the native Matter framework.)
MATTER_COMMISSIONING_METHOD=GooglePlayServices

# ── WECHAT LOGIN (native) ─────────────────────────────────────────────────────
# Present for the iOS binary (which offers WeChat to CN-region users at
# runtime). UNUSED by the Android global flavor — the WeChat native module ships
# only in the Android `cn` flavor, so the global APK never reads these.
WECHAT_APP_ID=wx9d48fe3e583d36ab
WECHAT_UNIVERSAL_LINK=https://wechat-212038829774-prod.s3.cn-north-1.amazonaws.com.cn/

# ── ACTIVE SDK (region) ───────────────────────────────────────────────────────
# rainmaker-base-sdk | rainmaker-neo-base-sdk | rainmaker-matter-sdk
ACTIVE_SDK=rainmaker-matter-sdk

# ── RM SDK CLOUD (region) ─────────────────────────────────────────────────────
BASE_URL=https://api.rainmaker.espressif.com
API_VERSION=v1
THIRD_PARTY_AUTH_AUTH_URL=https://3pauth.rainmaker.espressif.com
THIRD_PARTY_AUTH_CLIENT_ID=1h7ujqjs8140n17v0ahb4n51m2
THIRD_PARTY_AUTH_REDIRECT_URL=rainmaker://com.espressif.novahome/success
CLAIM_URL=https://esp-claiming.rainmaker.espressif.com

# ── RainMaker Neo SDK (region; public RainMaker Neo deployment — same values as .env.cn) ─
RMNEO_BASE_URL=https://api.neo.rainmaker.espressif.com
RMNEO_USER_API_BASE=https://user.api.neo.rainmaker.espressif.com
RMNEO_AWS_REGION=us-east-1
RMNEO_IOT_ENDPOINT=mqtt.neo.rainmaker.espressif.com

# ── PUBLIC WEBSITE & LEGAL (region; {lang} replaced at runtime with en/zh) ────
WEBSITE_LINK=https://rainmaker.espressif.com
TERMS_OF_USE_LINK=https://rainmaker.espressif.com/{lang}/terms-of-use?region=global
PRIVACY_POLICY_LINK=https://rainmaker.espressif.com/{lang}/privacy-policy?region=global

# ── THIRD-PARTY LOGIN PROVIDERS (region; list order = display order) ──────────
ENABLE_THIRD_PARTY_AUTH=true
THIRD_PARTY_AUTH_ENABLED_PROVIDERS=Google,SignInWithApple

# ── FEATURE AVAILABILITY (region + binary; disable-only cascade) ──────────────
ENABLE_SCENES=true
ENABLE_SCHEDULES=true
ENABLE_AUTOMATIONS=true
ENABLE_LOCAL_CONTROL=true
ENABLE_NOTIFICATIONS=true
ENABLE_GROUP_SHARING=true
ENABLE_OTA=true
ENABLE_AI_AGENT=true
ENABLE_VOICE_ASSISTANTS=true
ENABLE_CONTROL_GROUPS=true
ENABLE_ON_NETWORK_PROVISIONING=true
# SoftAP provisioning (opt-in; absent or false keeps the app flow disabled).
ENABLE_SOFTAP_PROVISIONING=false
ENABLE_CDF_AUTOSYNC=true
# ── ANDROID SIGNING (native; release keystore for this flavor) ────────────────
# Written to the gitignored android/keystore.properties by `npm run prebuild:android`
# and read by build.gradle's release signingConfig at build time. Each flavor's
# .env carries its OWN keystore, so a build signs with that flavor's key. Put REAL
# values only in the local .env.global / .env.cn (gitignored); keep the committed
# .example lines blank. The .jks lives under android/app/sign/ (path relative to
# android/app/).
ANDROID_KEYSTORE_FILE=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
