# Copy to esp_devices.yaml
#
# Wi-Fi credentials are lab-wide.
# ESP hardware is discovered automatically by MAC address.
#
# CI: download/build firmware into FIRMWARE_ROOT before chip tests.

wifi:
  ssid: "${PROVISION_WIFI_SSID:-ESP_WIFI}"
  ssid_password: "${PROVISION_WIFI_PASSWORD:-PASSword01}"

firmware_repository:
  # Directory of per-chip firmware bundles, e.g. firmwares/<bundle_esp32c3>, firmwares/<bundle_esp32s2>.
  # Each bundle must contain build_details.info|txt and Firmware/<type>/build/.
  root_dir: "${FIRMWARE_ROOT:-firmwares}"  # relative to test/
  firmware_type: Evaluation   # Evaluation | OTA

hardware:
  lock_db_path: hardware/.resource_locks.db
  lock_stale_seconds: 300
  acquire_timeout_seconds: 30
  esptool_path: "python -m esptool"

# E2E suites reserve a chip of e2e_chip_type, bind it to its cloud node, reuse if online else BLE-provision, and name it e2e_fw_name.
e2e_chip_type: esp32c3
e2e_fw_name: Light

