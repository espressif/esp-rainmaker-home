# iOS Fastlane — environment variable reference
#
# Secrets → GitLab CI/CD Variables (Settings → CI/CD → Variables, masked).
# Non-secrets → mac-mini-runner file ~/.esp-rainmaker-ios-fastlane.env
#   (sourced explicitly in .gitlab-ci.yml ios_ipa job — not from ~/.zprofile).
#
# Fastfile reads process env only. See ios/fastlane/README.md.

# --- GitLab CI/CD Variables (secrets; do NOT put on mac-mini file) ---
# IOS_P12_PASSWORD=
# IOS_KEYCHAIN_PASSWORD=
# XCODE_ORG_ID=
# PRIVATE_TOKEN=

# --- mac-mini-runner ~/.esp-rainmaker-ios-fastlane.env (non-secrets) ---
IOS_CERTIFICATE_FILE=example_distribution.p12
IOS_PROFILE_FILES=example_app_adhoc.mobileprovision,example_extension_adhoc.mobileprovision
IOS_XCODE_TARGETS=APP,MyExtension
IOS_BUNDLE_IDS=com.example.myapp,com.example.myapp.extension
IOS_PROFILE_NAMES=My App Ad Hoc,My Extension Ad Hoc
IOS_SCHEME=APP
IOS_OUTPUT_IPA_NAME=MyApp-adhoc.ipa

# --- GitLab API (only for manual runs outside GitLab CI) ---
# IOS_GITLAB_API_URL=https://gitlab.example.com/api/v4
# IOS_GITLAB_PROJECT_ID=my-group/my-project
