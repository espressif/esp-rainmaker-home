# Web build config (copy to `.env.web` — gitignored).
# Read by app.config.ts and deployment/web/scripts/sync-firebase-messaging-sw.js
# on every `npm run web` / `npm run build:web`. In CI the same file is supplied
# base64-encoded as the FS_ENV_WEB_FILE variable (see deployment/web/README.md).
#
# All values below are public client-side Firebase web config (not secrets),
# but they identify your Firebase project, so keep the real file out of git.

# Firebase → Project settings → Your apps → Web app → SDK setup and configuration
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
# Firebase → Project settings → Cloud Messaging → Web Push certificates (key pair)
FIREBASE_WEB_VAPID_KEY=

# RainMaker cloud the web bundle talks to: global | cn (see config/region.config.ts)
APP_REGION=global
