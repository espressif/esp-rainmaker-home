# =============================================================================
# WEB — full Expo `.env` for `npm run web` / `npm run build:web`
# =============================================================================
# Copied onto `.env` by scripts/sync-env-to-web.js so process.env (app identity,
# APP_REGION selector, binary feature flags in app.config.ts extra.features,
# Matter, deep links, etc.) comes from this file.
#
# Region cloud URLs / legal links / region-level features still come from
# .env.global + .env.cn → extra.regionConfigs (unchanged). BASE_URL and friends
# below are kept for parity with Secure Files and documentation; they do not
# replace regionConfigs unless you change app.config.ts again.
#
# Firebase FIREBASE_WEB_* keys are web-only (SW sync + extra.firebaseWeb).
# Internal: `npm run env:pull:web`. CI: Secure File `.env.web`.
# =============================================================================

# ── APP IDENTITY ─────────────────────────────────────────────────────────────
APP_NAME=ESP RainMaker Home
IOS_APP_APPLICATION_ID=com.espressif.nova
ANDROID_APP_APPLICATION_ID=com.espressif.novahome
IOS_APP_GROUP_ID=group.com.espressif.novahome
APP_SLUG=esp-rainmaker-home
APP_SCHEMA=rainmaker

# RainMaker cloud the web bundle selects: global | cn | auto
# (auto → global on web; see config/region.config.ts)
APP_REGION=global

ENABLE_SCAN_CONFIGURATION=true
BRAND_JSON_PATH=

THIRD_PARTY_AUTH_REDIRECT_SCHEME=rainmaker
THIRD_PARTY_AUTH_REDIRECT_HOST=com.espressif.novahome

AGENTS_DEEP_LINK_SCHEME=rainmaker
AGENTS_DEEP_LINK_HOST=agents.espressif.com
AGENTS_DEEP_LINK_PATH_PREFIX=/try/agents

MATTER_VENDOR_ID=0x131B
MATTER_ECOSYSTEM_NAME=Rainmaker Home
MATTER_COMMISSIONING_METHOD=GooglePlayServices

WECHAT_APP_ID=
WECHAT_UNIVERSAL_LINK=

ACTIVE_SDK=rainmaker-base-sdk

BASE_URL=https://api.rainmaker.espressif.com
API_VERSION=v1
THIRD_PARTY_AUTH_AUTH_URL=https://3pauth.rainmaker.espressif.com
THIRD_PARTY_AUTH_CLIENT_ID=1h7ujqjs8140n17v0ahb4n51m2
THIRD_PARTY_AUTH_REDIRECT_URL=rainmaker://com.espressif.novahome/success
CLAIM_URL=https://esp-claiming.rainmaker.espressif.com

RMNEO_BASE_URL=https://api.neo.rainmaker.espressif.com
RMNEO_USER_API_BASE=https://user.api.neo.rainmaker.espressif.com
RMNEO_AWS_REGION=us-east-1
RMNEO_IOT_ENDPOINT=mqtt.neo.rainmaker.espressif.com

WEBSITE_LINK=https://rainmaker.espressif.com
TERMS_OF_USE_LINK=https://rainmaker.espressif.com/{lang}/terms-of-use?region=global
PRIVACY_POLICY_LINK=https://rainmaker.espressif.com/{lang}/privacy-policy?region=global

ENABLE_THIRD_PARTY_AUTH=false
THIRD_PARTY_AUTH_ENABLED_PROVIDERS=Google,SignInWithApple
ENABLE_NATIVE_APPLE_SIGN_IN=false

# Binary-level feature overrides (extra.features) — disable-only unless noted
ENABLE_SCENES=true
ENABLE_SCHEDULES=true
ENABLE_AUTOMATIONS=true
ENABLE_LOCAL_CONTROL=false
ENABLE_NOTIFICATIONS=true
ENABLE_GROUP_SHARING=true
ENABLE_OTA=true
ENABLE_AI_AGENT=false
ENABLE_VOICE_ASSISTANTS=false
ENABLE_CONTROL_GROUPS=false
ENABLE_ON_NETWORK_PROVISIONING=false
ENABLE_SOFTAP_PROVISIONING=false
ENABLE_CDF_AUTOSYNC=true
ENABLE_BACKEND_SELECTOR=true

# Firebase → Project settings → Your apps → Web app → SDK setup and configuration
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
# Firebase → Project settings → Cloud Messaging → Web Push certificates (key pair)
FIREBASE_WEB_VAPID_KEY=
