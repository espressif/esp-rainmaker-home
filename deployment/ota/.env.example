# OTA publish/promote environment.
#
# In CI, these come from GitLab CI/CD masked variables. For local publishes
# (open-source forkers, or dev-side troubleshooting):
#
#   cp deployment/ota/.env.example deployment/ota/.env.local
#   # populate values below
#   set -a && source deployment/ota/.env.local && set +a
#   node deployment/ota/scripts/build-manifest.js "$APP_ASSETS_URL/…" ios
#   node deployment/ota/scripts/publish.js  --region global --platform ios --version <n>
#   node deployment/ota/scripts/promote.js  --region global --platform ios --version <n>
#
# `deployment/ota/.env.local` is gitignored — never commit it.

# --- AWS ---
# IAM user scoped to the ota/ prefix of the shared bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- S3 + CloudFront ---
# Bucket that fronts the OTA CloudFront distribution
APP_ASSETS_S3_BUCKET=
# CloudFront distribution id (used by deployment/ota/scripts/promote.js for invalidation)
CLOUDFRONT_DISTRIBUTION_ID=
# CloudFront hostname or full URL — used for asset URLs in the manifest
# and for the promote sanity-check curls
APP_ASSETS_URL=https://<your-ota-cf-hostname>

# --- Manifest signing ---
# Base64 of the RSA private key at deployment/ota/certs/private-key.pem.
# Generate locally: base64 -i deployment/ota/certs/private-key.pem
OTA_SIGNING_KEY_PEM=
